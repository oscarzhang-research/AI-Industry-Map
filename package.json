    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "dompurify": "3.4.16",
    "echarts": "6.1.0",
    "html-to-image": "1.11.13",
    "lucide-react": "1.55.0",
    "marked": "18.1.0",
    "minisearch": "7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.4",
    "yaml": "2.9.1"
